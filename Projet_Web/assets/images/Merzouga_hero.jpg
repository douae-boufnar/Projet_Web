    <script>
    window.__isB2BUser = (function() {
        try {
            const isAffiliate     = !!localStorage.getItem('affiliateLogin');
            const isAgency        = !!localStorage.getItem('agencyLogin');
            const isAccommodation = !!localStorage.getItem('accommodationLogin');

            const readCookieValue = (name) => {
                const nameEQ = name + '=';
                const ca = document.cookie.split(';');
                for (let i = 0; i < ca.length; i++) {
                    let c = ca[i];
                    while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                    if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
                }
                return null;
            };

            const urlParams = new URLSearchParams(window.location.search);
            const idAffiliateCookie = urlParams.get('aid') || readCookieValue('aid');
            const idAgencyCookie = urlParams.get('ag_aid') || readCookieValue('ag_aid');
            const aidNum = parseInt(idAffiliateCookie, 10);
            const hasAid   = !!(idAffiliateCookie) && Number.isFinite(aidNum) && aidNum >= 1000;
            const hasAgAid = !!(idAgencyCookie);

            return isAffiliate || isAgency || isAccommodation || hasAid || hasAgAid;
        } catch (e) {
            return false;
        }
    })();
</script>

