<script>
    dataLayer = window.dataLayer || [];
  
            var userCivitatisId;
        try {
            if (!localStorage.getItem('user_civitatisID')) {
                userCivitatisId = Date.now() * 1000 + Math.floor(Math.random() * 101);
                localStorage.setItem('user_civitatisID', JSON.stringify(userCivitatisId));
                localStorage.setItem('user_civitatisID-exp', JSON.stringify(Date.now() + 30 * 24 * 60 * 60 * 1000));
            } else {
                userCivitatisId = JSON.parse(localStorage.getItem('user_civitatisID'));
            }
        } catch (e) {}

        var userLoginId = null;
        try { userLoginId = JSON.parse(localStorage.getItem('userLogin')); } catch(e) {}

        if (userLoginId) {
            try {
                var pendingLogin = sessionStorage.getItem('pendingGTMLoginEvent');
                if (pendingLogin) {
                    sessionStorage.removeItem('pendingGTMLoginEvent');
                    var pendingLoginData = JSON.parse(pendingLogin);
                    if (Date.now() - pendingLoginData.ts < 30000) {
                        dataLayer.push({
                            'event': 'login',
                            'userid': String(userLoginId),
                            'user_civiId': String(userLoginId),
                            'user_loginStatus': 'true',
                            'method': pendingLoginData.method,
                        });
                    }
                }
            } catch (e) {}
        }
        dataLayer.push({
            'event': 'user_data_loaded',
            'userid': userLoginId ? String(userLoginId) : undefined,
            'user_civiId': userLoginId ? String(userLoginId) : undefined,
            'user_loginStatus': userLoginId ? 'true' : 'false',
        })
        window.geoCode = 'MA';
    dataLayer.push({
        'pageLanguage': 'en',
        'geoCode': 'MA',
    });
</script>




